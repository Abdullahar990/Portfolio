# This portfolio runs without API keys or paid animation services.
# Keep future private credentials in .env.local.
# MCP authentication belongs in Codex, never NEXT_PUBLIC_* variables.

# Optional: set SITE_URL to your actual https:// production origin (no path).
# Leave unset locally; unconfigured local builds remain non-indexable.
# Vercel uses VERCEL_PROJECT_PRODUCTION_URL when SITE_URL is absent.
# Set the same real production origin for preview builds; never a preview URL.
# SITE_URL=
